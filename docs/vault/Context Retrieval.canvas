    {"id":"c4","fromNode":"search","fromSide":"right","toNode":"hits","toSide":"left","toEnd":"arrow"},
    {"id":"c5","fromNode":"hits","fromSide":"right","toNode":"read","toSide":"left","toEnd":"arrow","label":"Select relevant source"},
    {"id":"c6","fromNode":"read","fromSide":"right","toNode":"answer","toSide":"left","toEnd":"arrow"}
  ]
}
