      "toNode": "work",
      "toSide": "left",
      "toEnd": "arrow"
    },
    {
      "id": "q5",
      "fromNode": "work",
      "fromSide": "right",
      "toNode": "settle",
      "toSide": "left",
      "toEnd": "arrow",
      "label": "Finish / Stop / failure"
    },
    {
