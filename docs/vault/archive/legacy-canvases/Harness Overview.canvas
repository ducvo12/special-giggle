	"nodes":[
		{"id":"harness","type":"text","text":"## Agent harness\n\nOwns the model loop.\n\nAssembles context, requests responses, manages tool outcomes and run status.","x":40,"y":40,"width":360,"height":230,"color":"5"},
		{"id":"app","type":"text","text":"## Granite app\n\nCollects the message, agent, model and settings.\n\nDisplays text, activity and approvals.","x":-720,"y":10,"width":320,"height":210,"color":"4"},
		{"id":"boundary","type":"text","text":"## Delivery boundary\n\nCore/repository/setup: implemented.\nScoped memory/retrieval: pass 4.\nTemporary/container lifecycle: pass 5.\n\n[[Harness Implementation Plan]]","x":-840,"y":480,"width":320,"height":200},
		{"id":"policy","type":"text","text":"## Validation and permissions\n\nChecks tool names, arguments and policy.\n\nRequests approval when needed; enforces permissions in backend code.","x":-80,"y":570,"width":360,"height":220,"color":"2"},
