      "fromNode": "result",
      "fromSide": "right",
      "toNode": "finish",
      "toSide": "left",
      "toEnd": "arrow",
      "label": "Next response: no tools"
    },
    {
      "id": "e6",
      "fromNode": "edit",
      "fromSide": "bottom",
      "toNode": "rejected",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "Stale contents; no mutation",
      "color": "2"
    },
    {
      "id": "e7",
      "fromNode": "rejected",
      "fromSide": "right",
      "toNode": "recover",
      "toSide": "left",
      "toEnd": "arrow",
      "label": "Tool error → model",
      "color": "2"
    },
    {
      "id": "e8",
      "fromNode": "recover",
      "fromSide": "right",
      "toNode": "retry",
      "toSide": "left",
      "toEnd": "arrow",
      "label": "Read, revise",
      "color": "2"
    },
    {
      "id": "e9",
      "fromNode": "retry",
      "fromSide": "right",
      "toNode": "recovered",
      "toSide": "left",
      "toEnd": "arrow",
      "label": "Applied",
      "color": "3"
    },
    {
      "id": "e10",
      "fromNode": "retry",
      "fromSide": "bottom",
      "toNode": "giveup",
      "toSide": "top",
      "toEnd": "arrow",
      "label": "Failed again",
      "color": "1"
    }
  ]
}
