{
  "name": "granite",
  "version": "0.1.0",
  "private": true,
  "description": "A local desktop workspace for personal agents",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.test.json",
    "lint": "oxlint --deny-warnings src tests scripts electron.vite.config.ts",
    "build": "npm run typecheck && electron-vite build",
    "package": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "test": "node scripts/test.mjs",
    "postinstall": "electron-builder install-app-deps",
    "verify:shell": "node scripts/verify-shell-desktop.mjs"
  },
  "build": {
    "appId": "dev.granite.desktop",
    "productName": "Granite",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg"
      ]
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "Utility"
    },
    "extraResources": [
      {
        "from": "docs/third-party",
        "to": "third-party-notices"
      }
    ]
  },
  "dependencies": {
    "jose": "^6.2.12",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^6.0.0",
    "oxlint": "^1.90.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  }
}
